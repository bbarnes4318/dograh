{
  "version": 1,
  "about": "Compatibility manifest for files bind-mounted over the dograh-api image on the hopwhistle box. Every mount on the api service must have an entry here, or the cutover plan blocks. A variant is recognised when every 'detect' regex matches the mounted file. Each behavior it carries must be present in the target image ('evidence', checked in the image itself) and, where status is 'config', reproduced by the environment the planner derives. 'requires_ack' variants are recognised by heuristics only: the operator must review the diff (cutover_plan.py diff) and acknowledge the mounted file's sha256. See README.md, 'Mount compatibility'.",
  "mounts": {
    "/app/api/services/telephony/providers/ari/provider.py": {
      "kits": [
        "hoppwhistle deploy/dograh/ari-trunk",
        "hoppwhistle deploy/dograh/vonage-trunk/setup_vonage.py",
        "box-local edits read by the old 2_cutover.sh"
      ],
      "action": "remove_when_preserved",
      "variants": [
        {
          "id": "ari_trunk_patch_v1",
          "detect": [
            "HOPWHISTLE_ARI_TRUNK_V1"
          ],
          "behaviors": [
            "ari_trunk_from_patch_env",
            "ari_any_technology"
          ]
        },
        {
          "id": "ari_dial_prefix_v2",
          "detect": [
            "HOPWHISTLE_ARI_DIAL_PREFIX_V2"
          ],
          "behaviors": [
            "ari_dial_prefix"
          ]
        },
        {
          "id": "ari_dial_format_v3",
          "detect": [
            "HOPWHISTLE_ARI_DIAL_FORMAT_V3"
          ],
          "behaviors": [
            "ari_dial_format"
          ]
        },
        {
          "id": "ari_caller_trunk_v1",
          "detect": [
            "HOPWHISTLE_ARI_CALLER_TRUNK_V1"
          ],
          "behaviors": [
            "ari_caller_trunks"
          ]
        },
        {
          "id": "stock_hardcoded_trunk",
          "detect": [
            "f\"PJSIP/\\{to_number\\}@[A-Za-z0-9_.-]+\""
          ],
          "behaviors": [
            "ari_literal_trunk"
          ],
          "requires_ack": true
        },
        {
          "id": "fork_default_trunk",
          "detect": [
            "def _pjsip_endpoint\\(",
            "ARI_PJSIP_DEFAULT_TRUNK"
          ],
          "behaviors": [
            "ari_env_default_trunk"
          ]
        },
        {
          "id": "transfer_caller_id_literal",
          "detect": [
            "kwargs\\.get\\(\"caller_id\"\\)\\s*or\\s*\"\\+?\\d+\""
          ],
          "behaviors": [
            "ari_transfer_caller_id_literal"
          ],
          "requires_ack": true
        },
        {
          "id": "transfer_caller_id_env",
          "detect": [
            "ARI_TRANSFER_DEFAULT_CALLER_ID"
          ],
          "behaviors": [
            "ari_transfer_caller_id_env"
          ]
        }
      ],
      "exclusive": [
        [
          "ari_trunk_patch_v1",
          "fork_default_trunk"
        ],
        [
          "ari_caller_trunk_v1",
          "stock_hardcoded_trunk"
        ],
        [
          "ari_caller_trunk_v1",
          "ari_trunk_patch_v1"
        ],
        [
          "ari_trunk_patch_v1",
          "stock_hardcoded_trunk"
        ]
      ],
      "require_one_of": [
        "ari_trunk_patch_v1",
        "stock_hardcoded_trunk",
        "fork_default_trunk"
      ]
    },
    "/app/api/services/campaign/campaign_call_dispatcher.py": {
      "kits": [
        "hoppwhistle deploy/dograh/patches/campaign_call_dispatcher.py",
        "box-local edits read by the old 2_cutover.sh"
