            "NO_CALLER_ID_AVAILABLE_FOR_DESTINATION_STATE"
          ],
          "behaviors": [
            "state_caller_id"
          ]
        }
      ],
      "exclusive": [
        [
          "forced_shared_did",
          "context_then_literal"
        ],
        [
          "forced_shared_did",
          "source_resolver"
        ]
      ],
      "require_one_of": [
        "forced_shared_did",
        "context_then_literal",
        "source_resolver"
      ]
