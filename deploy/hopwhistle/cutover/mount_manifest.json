  "behaviors": {
    "ari_trunk_from_patch_env": {
      "description": "Outbound trunk from DOGRAH_ARI_TRUNK (patch default 'fractel'); transfer trunk from DOGRAH_ARI_TRANSFER_TRUNK (default: the outbound trunk).",
      "status": "config",
      "env": [
        "ARI_PJSIP_DEFAULT_TRUNK",
        "ARI_PJSIP_TRANSFER_TRUNK"
      ],
      "source": "api/services/telephony/providers/ari/dialing.py",
      "evidence": [
        {
          "path": "/app/api/services/telephony/providers/ari/dialing.py",
          "pattern": "ARI_PJSIP_TRANSFER_TRUNK"
        },
        {
          "path": "/app/api/services/telephony/providers/ari/provider.py",
          "pattern": "transfer_endpoint\\("
        }
      ]
    },
    "ari_any_technology": {
      "description": "Any Tech/... destination (Local/, IAX2/) is dialled as written; needed by the Local/ direct-transfer destination.",
      "status": "config",
      "env": [
        "ARI_DIAL_ANY_TECHNOLOGY"
      ],
      "source": "api/services/telephony/providers/ari/dialing.py",
      "evidence": [
        {
          "path": "/app/api/services/telephony/providers/ari/dialing.py",
          "pattern": "ARI_DIAL_ANY_TECHNOLOGY"
        }
