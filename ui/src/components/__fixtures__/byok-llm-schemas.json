    "aws_bedrock": {
      "properties": {
        "provider": {
          "const": "aws_bedrock",
          "default": "aws_bedrock",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Not used for Bedrock \u2014 authentication is via the AWS credentials above. Leave blank.",
          "title": "Api Key"
        },
        "model": {
          "allow_custom_input": true,
          "default": "us.amazon.nova-pro-v1:0",
          "description": "Bedrock model ID \u2014 include the region inference-profile prefix (e.g. 'us.').",
          "examples": [
            "us.amazon.nova-pro-v1:0",
            "us.amazon.nova-lite-v1:0",
            "us.amazon.nova-micro-v1:0",
            "us.anthropic.claude-sonnet-4-20250514-v1:0",
            "us.anthropic.claude-3-5-sonnet-20241022-v2:0",
            "us.anthropic.claude-haiku-4-5-20251001-v1:0"
          ],
          "title": "Model",
          "type": "string"
        },
        "aws_access_key": {
          "default": "",
          "description": "AWS access key ID with bedrock:InvokeModel permission.",
          "title": "Aws Access Key",
          "type": "string"
        },
        "aws_secret_key": {
          "default": "",
          "description": "AWS secret access key paired with the access key ID.",
          "title": "Aws Secret Key",
          "type": "string"
        },
        "aws_region": {
          "default": "us-east-1",
          "description": "AWS region where the Bedrock model is available.",
          "title": "Aws Region",
          "type": "string"
        },
        "enable_prompt_caching": {
          "default": false,
          "description": "Send prompt cache points on the system prompt and tool schemas. Cuts time-to-first-token on models that support it, but Bedrock rejects cache points on models that do not \u2014 and a rejected request fails every turn of the call. Leave off unless you have confirmed your model accepts them.",
          "title": "Enable Prompt Caching",
          "type": "boolean"
        }
      },
      "title": "AWS Bedrock",
      "type": "object"
    },
