  "llm": {
    "openai": {
      "properties": {
        "provider": {
          "const": "openai",
          "default": "openai",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Api Key"
        },
        "model": {
          "allow_custom_input": true,
          "default": "gpt-4.1",
          "description": "OpenAI chat model to use.",
          "examples": [
            "gpt-4.1",
            "gpt-4.1-mini",
            "gpt-4.1-nano",
            "gpt-5",
            "gpt-5-mini",
            "gpt-5-nano",
            "gpt-3.5-turbo"
          ],
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.openai.com/v1",
          "description": "Override only if using an OpenAI-compatible API (e.g. local LLM, proxy).",
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "OpenAI",
      "type": "object"
    },
