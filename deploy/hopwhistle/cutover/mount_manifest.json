          ],
          "behaviors": [
            "transfer_forced_shared_did"
          ]
        },
        {
          "id": "context_then_literal",
          "detect": [
            "\"transfer_destination\":\\s*\\((?:[^\\n]*\\n){0,4}?[^\\n]*\"\\+?\\d{7,}\""
          ],
          "behaviors": [
            "transfer_context_then_literal"
          ],
          "requires_ack": true
        },
        {
          "id": "source_resolver",
          "detect": [
