    "inception": {
      "description": "Inception Mercury diffusion LLMs. Mercury 3 decodes tokens in parallel for very low time-to-first-token, and exposes a reasoning effort knob to trade latency against depth. Mercury Voice is tuned for voice agents (enterprise access from Inception) and accepts only low, medium or high reasoning effort.",
      "properties": {
        "provider": {
          "const": "inception",
          "default": "inception",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Api Key"
        },
        "model": {
          "allow_custom_input": true,
          "default": "mercury-3",
          "description": "Inception Mercury model identifier.",
          "examples": [
            "mercury-3",
            "mercury-voice"
          ],
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.inceptionlabs.ai/v1",
          "description": "Override only if proxying Inception through your own gateway.",
          "title": "Base Url",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "low",
          "description": "How much of the diffusion budget Mercury spends on reasoning. 'instant' is fastest; raise it for harder turns at the cost of time-to-first-token. Mercury Voice does not offer 'instant'; use 'low' for the fastest Voice turns.",
          "enum": [
            "instant",
            "low",
            "medium",
            "high"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        }
      },
      "provider_docs_url": "https://docs.inceptionlabs.ai/",
      "required": [
        "api_key"
      ],
      "title": "Inception",
      "type": "object"
    },
