    },
    "ari_dial_prefix": {
      "description": "DOGRAH_ARI_DIAL_PREFIX: tech prefix before outbound NANP numbers (Anveo Direct). Never on transfers.",
      "status": "config",
      "env": [
        "ARI_DIAL_PREFIX"
      ],
      "source": "api/services/telephony/providers/ari/dialing.py",
      "evidence": [
        {
          "path": "/app/api/services/telephony/providers/ari/dialing.py",
          "pattern": "ARI_DIAL_PREFIX"
        }
      ]
    },
    "ari_dial_format": {
      "description": "DOGRAH_ARI_DIAL_FORMAT: nanp11/nanp10 outbound number format (Vonage). Never on transfers.",
      "status": "config",
      "env": [
        "ARI_DIAL_FORMAT"
      ],
      "source": "api/services/telephony/providers/ari/dialing.py",
      "evidence": [
        {
          "path": "/app/api/services/telephony/providers/ari/dialing.py",
          "pattern": "ARI_DIAL_FORMAT"
