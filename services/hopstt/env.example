# HopSTT settings. Copy to .env next to the compose files.

# --- required ---------------------------------------------------------------
# Bearer key for every endpoint except /healthz, /readyz, /metrics (>= 16 chars).
HOPSTT_API_KEY=
# Address the ports bind to on the host. Keep it private (127.0.0.1 or the
# GPU host's private IP); never a public interface.
HOPSTT_BIND=127.0.0.1

# --- placement ----------------------------------------------------------------
HOPSTT_LIVE_GPU=0
HOPSTT_BATCH_GPU=0
HOPSTT_IMAGE=hopstt:0.1.0
# HOPSTT_ROLE is set per compose service (live | batch | both).

# --- models -------------------------------------------------------------------
HOPSTT_LIVE_MODELS=nemotron-3.5-streaming
HOPSTT_BATCH_MODELS=parakeet-tdt-0.6b-v3
HOPSTT_FETCH_MODELS=nemotron-3.5-streaming,parakeet-tdt-0.6b-v3
HOPSTT_DEFAULT_STREAMING_MODEL=nemotron-3.5-streaming
HOPSTT_DEFAULT_BATCH_MODEL=parakeet-tdt-0.6b-v3
# Override a pinned Hugging Face commit: id=<40-hex commit>,id=...
HOPSTT_MODEL_REVISIONS=
# Local weight file/dir per model (air-gapped hosts): id=/path,...
# HOPSTT_MODEL_PATHS=
# HF_TOKEN=            # only needed by hopstt-fetch for gated repos
# HOPSTT_ALLOW_DOWNLOAD=false

# --- live streaming ----------------------------------------------------------
HOPSTT_MAX_STREAMS=64
HOPSTT_MAX_BATCH_SIZE=64
# HOPSTT_CONFIG_TIMEOUT_S=5
# HOPSTT_IDLE_TIMEOUT_S=30
# HOPSTT_MAX_QUEUE_MS=2000
# HOPSTT_MAX_LAG_MS=3000
# HOPSTT_MAX_FRAME_BYTES=65536
# HOPSTT_ALLOW_QUERY_TOKEN=false
# HOPSTT_VAD_THRESHOLD_DBFS=-45
# HOPSTT_VAD_MIN_SPEECH_MS=60

# --- batch --------------------------------------------------------------------
HOPSTT_BATCH_MAX_CONCURRENCY=1
HOPSTT_BATCH_QUEUE_LIMIT=100
HOPSTT_MAX_UPLOAD_MB=200
# HOPSTT_SYNC_MAX_SECONDS=900
# HOPSTT_JOB_TTL_S=3600
# HOPSTT_JOB_MAX_ATTEMPTS=2
# HOPSTT_BATCH_PAUSE_AT_LIVE_UTIL=0.8   # role=both only
# HOPSTT_FFMPEG_TIMEOUT_S=300
# HOPSTT_WHISPER_COMPUTE_TYPE=auto      # float16 on cuda, int8 on cpu

# --- Voxtral Realtime (vllm_realtime engine) -----------------------------------
# HOPSTT_VLLM_URL=ws://vllm:8000/v1/realtime
# HOPSTT_VLLM_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602
# HOPSTT_VOXTRAL_DELAY_MS=480           # must match transcription_delay_ms on the vLLM server

# --- lifecycle ----------------------------------------------------------------
HOPSTT_DRAIN_TIMEOUT_S=600
# HOPSTT_LOG_LEVEL=info
