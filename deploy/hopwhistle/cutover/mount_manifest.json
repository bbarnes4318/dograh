      "source": "api/services/telephony/providers/ari/dialing.py",
      "evidence": [
        {
          "path": "/app/api/services/telephony/providers/ari/dialing.py",
          "pattern": "ARI_CALLER_TRUNKS"
        },
        {
          "path": "/app/api/services/telephony/providers/ari/provider.py",
          "pattern": "outbound_caller_id\\("
        }
      ]
